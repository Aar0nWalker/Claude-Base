{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{PROJECT_PATH_WSL}}/scripts/agent-task-hook.sh Claude",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PROJECT_PATH_WSL}}/scripts/agent-task-hook.sh Claude",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "WebSearch",

      "Bash(git *)",
      "Bash(gh *)",
      "Bash(docker *)",
      "Bash(curl *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(mkdir *)",

      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(tsc *)",

      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py -3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pytest *)",

      "Bash(rtk *)"
    ],
    "deny": []
  }
}
