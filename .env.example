# {{PROJECT_NAME}} environment. Copy to .env and fill in. NEVER commit .env.
#
# The template ships only the agent-tooling variables. Everything your project needs —
# database URLs, API keys, ports — is added here during bootstrap, alongside the stack
# that requires it. Keep this file in sync with .env: a variable the code reads but this
# file never mentions is how a deploy fails on a fresh machine.

# ── Release target (only if the project deploys somewhere) ────────────────────
# See docs/deploy-contract.md.
DEPLOY_PATH=
DEPLOY_SSH=

# ── Telegram worker-bot (optional: task queue for agents) ────────────────────
WORKER_BOT_TOKEN=
WORKER_BOT_ALLOWED_USER_IDS=
WORKER_BOT_PROXY_URL=
WORKER_BOT_NO_PROXY=localhost,127.0.0.1,::1

# ── Agent tooling (optional) ─────────────────────────────────────────────────
# Token-compression proxy for the model API; leave empty for a direct connection.
ANTHROPIC_BASE_URL=
