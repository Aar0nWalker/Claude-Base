# {{PROJECT_NAME}} — environment. Copy to .env and fill in. NEVER commit .env.

# ── Core ──────────────────────────────────────────────────────────────────────
APP_URL=https://{{DOMAIN}}
BACKEND_URL=http://api:8000
# Must be changed from the default or the API refuses to boot.
JWT_SECRET=changeme-generate-a-long-random-string

# ── Database (Postgres) ───────────────────────────────────────────────────────
POSTGRES_USER={{PROJECT_SLUG}}
POSTGRES_PASSWORD=
POSTGRES_DB={{PROJECT_SLUG}}
DATABASE_URL=postgresql+asyncpg://{{PROJECT_SLUG}}:@db:5432/{{PROJECT_SLUG}}

# ── Redis / queue ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Admin seed (created on first boot) ────────────────────────────────────────
ADMIN_EMAIL=admin@{{DOMAIN}}
ADMIN_PASSWORD=

# ── Email (SMTP) — verification / password reset ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@{{DOMAIN}}

# ── File storage (S3-compatible) — optional, falls back to local /storage ─────
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_KEY_ID=
S3_KEY_SECRET=
CDN_BASE=

# ── AI text helper (optional) — only if you use app/ai_text.py ────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=   # e.g. a Headroom token-compression proxy; leave empty for direct

# ── Deploy (deploy.sh / rollback.sh) ──────────────────────────────────────────
DEPLOY_PATH=/opt/{{PROJECT_SLUG}}
DEPLOY_SSH=root@{{PROD_IP}}
# DEPLOY_WINSCP_SITE=   # fallback ssh-config Host alias

# ── Telegram worker-bot (optional, dual-agent parallel work) ──────────────────
WORKER_BOT_TOKEN=
WORKER_BOT_ALLOWED_USER_IDS=
WORKER_BOT_PROXY_URL=
# WORKER_BOT_NO_PROXY=localhost,127.0.0.1,::1
