# ── template's own build docs (not your project's) ───────────────────────────
REWRITE-PLAN.md

# ── gate & release artifacts ─────────────────────────────────────────────────
.gate-logs/
deploy.log
deploy.run.log
rollback.log

# ── secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
secrets/
ssh/
*.pem
*cookies*.txt

# ── agent state: session mirrors + archived chats (local context, never shipped)
.agents/sessions/*
!.agents/sessions/.gitkeep
chat-archive/*
!chat-archive/README.md

# worker-bot RUNTIME (templates under .agents/ are tracked; runtime is not)
.agents/worker-bot/*.log
.agents/worker-bot/*.pid
.agents/worker-bot/*.lock
.agents/worker-bot/.lock
.agents/worker-bot/state.json
.agents/worker-bot/dispatch-*.log
.agents/worker-bot/*.tmp
.agents/worker-bot/screenshots/*
.agents/worker-bot/agents/*
!.agents/worker-bot/agents/.gitkeep
!.agents/worker-bot/screenshots/.gitkeep

# ── machine-local agent tooling / plugins (user-global, not part of the template)
.rtk/
.tools/
.uv-cache/
.claude/settings.local.json

# ── dependency & build output ────────────────────────────────────────────────
# Junk in every ecosystem. Kept generic on purpose: the stack is not decided yet,
# and an agent committing a dependency tree is a mess nobody enjoys unpicking.
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
target/
out/
*.egg-info/
.next/
*.tsbuildinfo

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── your project's own ignores go below ──────────────────────────────────────
# One warning learned the hard way: if your build uses a lockfile (npm ci,
# poetry.lock, Cargo.lock, go.sum), that lockfile MUST be committed. Ignoring it
# means the build works for you and breaks on every fresh clone.
